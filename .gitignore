# Secrets & local config
.env
.env.*
!.env.example

# Persistent data (bind-mounted into containers)
data/postgres/*
data/minio/*
data/redis/*
data/chroma/*
data/uploads/*
data/models/*
!data/*/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Misc
*.pid
*.seed
*.pid.lock

# Local backup files (e.g., docker-compose.yml.bak.<ts>)
*.bak
*.bak.*

# Android APK build artifacts (regenerable)
/build/twa/app/build/
/build/twa/.gradle/
/build/twa/cara-signing.keystore
frontend/public/cara.apk

# Whisper STT model cache (HuggingFace download, regenerable)
data/whisper-cache/models--*/
data/whisper-cache/CACHEDIR.TAG

# Piper voices that auto-download at runtime
data/tts/piper/voices/*.onnx
data/tts/piper/voices/*.onnx.json

# Local DB backups (regenerable via scripts/backup-postgres.sh)
backups/*.sql.gz
backups/*.sql
backups/*.dump

# RKLLM KV cache (regenerable, can be GBs)
data/kv_cache/
