{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CARA",
  "version": "0.1.0",
  "identifier": "it.pedoto.cara.desktop",
  "build": {
    "frontendDist": "../public",
    "devUrl": "https://192.168.1.23:8455",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CARA",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "url": "https://192.168.1.23:8455/",
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "CARA"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "CARA — Casa AI for Routines & Activities",
    "longDescription": "Native desktop client for CARA. Loads the home server in a slim system webview, with a system tray icon so you can hide it without quitting. Lightweight (~8 MB binary) and starts in well under a second.",
    "category": "Utility",
    "publisher": "Pedoto",
    "homepage": "https://github.com/pedotoantonio/cara",
    "copyright": "2026 Antonio Pedoto",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
