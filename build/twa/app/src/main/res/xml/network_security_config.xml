<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust the LAN self-signed cert from the CARA server.
         Production deploys would use a real CA-signed cert. -->
    <domain-config>
        <domain includeSubdomains="false">192.168.1.23</domain>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
